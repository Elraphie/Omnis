# Omnis boots in dry-run. No private key is required to scan or to build Convert transactions.
MODE=dry-run
# MODE=paper
# MODE=live
# CONFIRM_LIVE=I_UNDERSTAND
# SIGNER_KIND=auto
# AGENT_PRIVATE_KEY=0x...
# SIGNER_KIND=kms refuses a hot key. Attach a KmsAdapter in code.

CELO_RPC=https://forno.celo.org
PORT=43123
# 0.0.0.0 for Docker. 127.0.0.1 keeps a local desk off the network.
HOST=0.0.0.0
DATA_DIR=./data
INTERVAL_SEC=60
QUOTE_SOURCE=auto
QUOTE_TIMEOUT_MS=8000
INCLUDE_EXTENDED=0

# Decision hurdles. Quoted outputs are already net of pool and RFQ fees.
# ADVERSE_BPS is an extra cushion per non-firm leg, not a second copy of the pool fee.
MIN_EDGE_USD=0.05
MIN_EDGE_BPS=3
ADVERSE_BPS=2
SLIPPAGE_BPS=30
MAX_TRADE_USD=100
MIN_TRADE_USD=2
SIZE_LADDER=1,0.5,0.25
MAX_DAILY_LOSS_USD=25
MAX_INVENTORY_USD=500
KILL_SWITCH=0
PAPER_USDT=1000
CELO_USD=0.3
GAS_PRICE_WEI_FALLBACK=5000000000

# Market making and rebalance.
MM_SPREAD_BPS=10
MM_SKEW_FACTOR_BPS=5000
MM_MAX_SKEW_BPS=40
REBALANCE_THRESHOLD_BPS=500
REBALANCE_MAX_COST_BPS=15
TARGET_USDT_BPS=10000

# Convert. Fee is taken from the input as a transfer the user signs. Leave the fee at 0 until the treasury is yours.
CONVERT_FEE_BPS=0
# TREASURY_ADDRESS=0xYourTreasury
CONVERT_SLIPPAGE_BPS=50
MAX_CONVERT_USD=500
# Comma-separated. Each key is 12-128 chars. Empty disables Convert.
API_KEYS=
# Operator keys for /admin/kill and for /status, /trades, /pnl, /metrics. Never reuse a Convert key here.
# Empty disables admin, and the status endpoints answer 401.
ADMIN_KEYS=
# Local development only: 1 serves status, trades, P&L, and metrics without a key.
PUBLIC_STATUS=0
# No wildcards. Same-host browser calls are allowed without being listed.
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=60

# Optional ERC-8021 code. Lowercase, digits, underscore. This is Omnis's tag, not Kiyoshi's.
# ATTRIBUTION_TAG=omnis_fx
TEXTILE_API=https://api.textilecredit.com

# Fiat reference for measurement only; no trading decision reads it. ExchangeRate-API format, daily rates. off disables.
FX_REFERENCE_URL=https://open.er-api.com/v6/latest/USD
FX_REFERENCE_TTL_SEC=3600

# Shadow execution: walk the best route as live mode would and record it. Never signs a transaction.
SHADOW=0
SHADOW_MIN_NET_BPS=0
SHADOW_MAX_PER_HOUR=20
# Optional. A dedicated wallet, not the trading key, that signs Textile's proof-of-control text for firm quotes.
# Textile only firm-quotes a taker holding the sell amount. Shadow mode never moves its funds.
# SHADOW_TAKER_KEY=0x...
STARTUP_DELAY_SEC=0
