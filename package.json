{
  "name": "omnis",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Omnis v2 — fee-aware Celo FX desk. Successor to Kiyoshi.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/cli/serve.ts",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' node dist/cli/serve.js",
    "once": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' tsx src/cli/once.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' vitest run"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "dotenv": "16.4.7",
    "viem": "2.57.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
